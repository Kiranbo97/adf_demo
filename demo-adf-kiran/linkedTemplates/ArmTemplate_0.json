		{
			"name": "[concat(parameters('factoryName'), '/PL_DEMO_INGESTION')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Execute_Send_Email_Pipeline",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "check source count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "success",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Execute_Send_Email_Pipeline_for_failure",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "check source count",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "PL_EMAIL_DEMO",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.table_name",
									"type": "Expression"
								},
								"status": "failed",
								"email_recepient": {
									"value": "@pipeline().globalParameters.email_recepient",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Read Watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select watermark_value from metadata.table_watermarks where table_name = '@{toLower(pipeline().parameters.table_name)}';",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_SERVER",
								"type": "DatasetReference",
								"parameters": {
									"schema": "abcd",
									"table_name": "xyz"
								}
							}
						}
					},
					{
						"name": "check source count",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Check Count in Source",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('Check Count in Source').output.firstRow.count,0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "ingest_SQL_DB_Data",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "select * from dbo.@{pipeline().parameters.table_name} where modifieddate > '@{activity('Read Watermark').output.firstRow.watermark_value}'",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
